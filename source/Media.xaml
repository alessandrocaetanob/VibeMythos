<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <BitmapImage x:Key="TrayIcon" UriSource="{ThemeFile 'Images/applogo.ico'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="TrayIconWhite" UriSource="{ThemeFile 'Images/applogo_blue.ico'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>

    <TextBlock x:Key="FullscreenModeIcon" Text="&#xe7f4;" FontFamily="{DynamicResource IconFontFamily}"/>
    <TextBlock x:Key="AddGameIcon" Text="&#xE710;" FontFamily="{DynamicResource IconFontFamily}"/>
    <TextBlock x:Key="UpdateDbIcon" Text="&#xe117;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="AboutPlayniteIcon" Text="" FontFamily="{DynamicResource FontFamily}" />
    <TextBlock x:Key="ExitIcon" Text="&#xe7e8;" FontFamily="{DynamicResource IconFontFamily}" Foreground="OrangeRed"/>
    <TextBlock x:Key="SettingsIcon" Text="&#xE713;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="AddonsIcon" Text="&#xea86;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="PlayIcon" Text="&#xF5B0;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="InstallIcon" Text="&#xe118;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="LinksIcon" Text="&#xe167;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="OpenFolderIcon" Text="&#xE8B7;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="InstallSizeIcon" Text="&#xE8EF;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="DesktopShortcutIcon" Text="&#xE836;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="AddFavoritesIcon" Text="&#xE734;" FontFamily="{DynamicResource IconFontFamily}" Foreground="Yellow"/>
    <TextBlock x:Key="RemoveFavoritesIcon" Text="&#xE735;" FontFamily="{DynamicResource IconFontFamily}" Foreground="Yellow"/>
    <TextBlock x:Key="HideIcon" Text="&#xe052;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="UnHideIcon" Text="&#xed1a;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="HdrIcon" Text="&#xeef2;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="EditGameIcon" Text="&#xEF60;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="RemoveGameIcon" Text="&#xe107;" FontFamily="{DynamicResource IconFontFamily}" Foreground="OrangeRed"/>
    <TextBlock x:Key="DiceIcon" Text="&#xE8B1;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="ManualIcon" Text="&#xe82d;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="BackupIcon" Text="&#xe7b8;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="RestoreBackupIcon" Text="&#xe777;" FontFamily="{DynamicResource IconFontFamily}" />

    <TextBlock x:Key="RightArrowIcon" Text="&#xE974;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="LeftArrowIcon" Text="&#xE973;" FontFamily="{DynamicResource IconFontFamily}" />

    <TextBlock x:Key="ClearTextIcon" Text="&#xef00;" FontFamily="{DynamicResource IconFontFamily}"/>
    <TextBlock x:Key="SearchTextIcon" Text="&#xed11;" FontFamily="{DynamicResource IconFontFamily}" />

    <TextBlock x:Key="SidebarLibraryIcon" Text="&#xea8a;" FontFamily="{DynamicResource IconFontFamily}" />
    <TextBlock x:Key="SidebarStatisticsIcon" Text="&#xEE93;" FontFamily="{DynamicResource IconFontFamily}"/>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <TextBlock Text="&#xeb90;" FontFamily="{DynamicResource IconFontFamily}" />
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <TextBlock Text="&#xe1a3;" FontFamily="{DynamicResource IconFontFamily}" />
    </DataTemplate>

    <BitmapImage x:Key="PlayniteLogo" UriSource="{ThemeFile 'Images/applogo.ico'}" popt:Freeze="True" />
    <BitmapImage x:Key="DefaultGameIcon" UriSource="{ThemeFile 'Images/icon.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DefaultGameCover" UriSource="{ThemeFile 'Images/cover.png'}" popt:Freeze="True" />

    <!-- DuplicateHider source icons.
         Key format is DuplicateHider_<SOURCENAME>_Icon, where SOURCENAME must match the
         source exactly as it appears in the plugin's Priority List. These only apply when
         "Enable Theme Icons" is switched on in DuplicateHider's settings — it is off by
         default. Any source without an entry here falls back to the plugin's own bundled
         icon set, so partial coverage is safe and no artwork is required for the rest.
         Filenames mirror source/Icons/Platform Source/, which the pure-theme badge already
         resolves through {ThemeFileBinding Game.Source.Name}. -->
    <BitmapImage x:Key="DuplicateHider_Steam_Icon" UriSource="{ThemeFile 'Icons/Platform Source/Steam.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_Epic Games_Icon" UriSource="{ThemeFile 'Icons/Platform Source/Epic Games.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_Battle.net_Icon" UriSource="{ThemeFile 'Icons/Platform Source/Battle.net.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_EA App_Icon" UriSource="{ThemeFile 'Icons/Platform Source/EA App.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_Ubisoft Connect_Icon" UriSource="{ThemeFile 'Icons/Platform Source/Ubisoft Connect.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_PC_Icon" UriSource="{ThemeFile 'Icons/Platform Source/PC.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_PCSX2_Icon" UriSource="{ThemeFile 'Icons/Platform Source/PCSX2.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_RPCS3_Icon" UriSource="{ThemeFile 'Icons/Platform Source/RPCS3.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_Xenia_Icon" UriSource="{ThemeFile 'Icons/Platform Source/Xenia.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DuplicateHider_Yuzu_Icon" UriSource="{ThemeFile 'Icons/Platform Source/Yuzu.png'}" popt:Freeze="True" />

    <!-- Shown when a source has neither a theme icon above nor a bundled plugin icon. -->
    <BitmapImage x:Key="DuplicateHider_Default_Icon" UriSource="{ThemeFile 'Images/icon.png'}" popt:Freeze="True" />

</ResourceDictionary>