<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">
    <!-- ⚠️ Motion tokens are duplicated here on purpose. Do not "clean this up" by pointing
         them at Constants.xaml - that is exactly what broke the theme on 2026-08-20.

         ThemeManager.ApplyTheme pre-flights EVERY theme file through Xaml.FromFile before it
         merges ANY of them, so during that pass StaticResource resolves against Playnite's
         default theme only - Constants.xaml is parsed but not yet in scope. A storyboard
         inside a Style or ControlTemplate must be frozen for the timing system, and freezing
         forces its StaticResource to resolve THEN, eagerly, instead of being deferred the way
         an ordinary Setter value is. So a motion token in Constants.xaml is unreachable from
         here: DynamicResource cannot freeze, and StaticResource resolves too early.

         Same values as Constants.xaml, which stays the source of truth for what they mean.
         Change one, change them all - tools/check_xaml_wpf.ps1 -PreFlight catches the failure
         mode, but not a value that has drifted. -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.22</Duration>
    <Duration x:Key="MotionSlow">0:0:0.4</Duration>
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut"/>
    <BackEase x:Key="EaseEmphasized" EasingMode="EaseOut" Amplitude="0.3"/>


    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" VerticalAlignment="Center"
                                    Width="40" Height="22"
                                    CornerRadius="{DynamicResource RadiusPill}"
                                    Background="{DynamicResource ControlIdleBackgroundBrush}">
                                <Grid>
                                    <Ellipse x:Name="Dot"
                                            Width="15" Height="15"
                                            Fill="White"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0"
                                            RenderTransformOrigin="0.5,0.5"
                        UseLayoutRounding="False"
                        SnapsToDevicePixels="False"
                        Opacity="0.6">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="DotTranslate" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border x:Name="BorderOverlay"
                                            CornerRadius="{DynamicResource RadiusPill}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlIdleBorderBrush}"
                                            Background="Transparent"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True"
                                            Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotTranslate"
                                                        Storyboard.TargetProperty="X"
                                                        To="17" Duration="{StaticResource MotionBase}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Dot"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="1" Duration="{StaticResource MotionBase}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotTranslate"
                                                        Storyboard.TargetProperty="X"
                                                        To="0" Duration="{StaticResource MotionBase}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Dot"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.6" Duration="{StaticResource MotionBase}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Background" Value="{DynamicResource AccentIdleBrush}" TargetName="BulletBorder"/>
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="BorderOverlay"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" TargetName="BulletBorder"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource AccentIdleBrushDarker}" TargetName="BulletBorder"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}"/>
                                <Condition Property="IsThreeState" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource SubtleControlBackgroundBrush}" TargetName="BulletBorder"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>