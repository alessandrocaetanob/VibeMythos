<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ⚠️ Motion tokens are duplicated here on purpose. Do not "clean this up" by pointing
         them at Constants.xaml - that is exactly what broke the theme on 2026-08-20.

         ThemeManager.ApplyTheme pre-flights EVERY theme file through Xaml.FromFile before it
         merges ANY of them, so during that pass StaticResource resolves against Playnite's
         default theme only - Constants.xaml is parsed but not yet in scope. A storyboard
         inside a Style or ControlTemplate must be frozen for the timing system, and freezing
         forces its StaticResource to resolve THEN, eagerly, instead of being deferred the way
         an ordinary Setter value is. So a motion token in Constants.xaml is unreachable from
         here: DynamicResource cannot freeze, and StaticResource resolves too early.

         Same values as Constants.xaml, which stays the source of truth for what they mean.
         Change one, change them all - tools/check_xaml_wpf.ps1 -PreFlight catches the failure
         mode, but not a value that has drifted. -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.22</Duration>
    <Duration x:Key="MotionSlow">0:0:0.4</Duration>
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut"/>
    <BackEase x:Key="EaseEmphasized" EasingMode="EaseOut" Amplitude="0.3"/>


    <ControlTemplate x:Key="ComboBoxListBaseTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Border BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Style="{DynamicResource HighlightBorder}"
                Background="{TemplateBinding Background}"
                x:Name="Root">
            <Grid>
                <DockPanel>
                    <Viewbox Margin="0,0,2,0" DockPanel.Dock="Right">
                        <TextBlock Text="6" FontFamily="Marlett"
                                   Foreground="Chocolate"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="5,0,0,0"/>
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="PART_ButtonClearFilter"
                        Margin="0,0,20,0" FontSize="{DynamicResource FontSizeLarge18}"
                        Background="Transparent" HorizontalAlignment="Right"
                        BorderThickness="0" Padding="3,0,3,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                    <Border Background="{DynamicResource SubtlePopUpBackgroundBrush}"
                            BorderThickness="{DynamicResource PopupBorderThickness}"
                            BorderBrush="{DynamicResource PopupBorderBrush}">
                        <ItemsControl x:Name="PART_ItemsPanel" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=MainToggle}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}" TargetName="Root"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FilterComboBoxListTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Border BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Style="{DynamicResource HighlightBorder}"
                Background="{TemplateBinding Background}"
                x:Name="Root">
            <Grid>
                <DockPanel>
                    <Viewbox Margin="0,1,10,0" DockPanel.Dock="Right" Width="10">
                        <TextBlock Text="&#xE96E;" Foreground="{DynamicResource SubtalBrush}"
                                   Style="{StaticResource IconFontStyle}"/>
                    </Viewbox>
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="8,0,25,0"/>
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="PART_ButtonClearFilter" Foreground="{DynamicResource PromptBrush}"
                        Margin="0,0,20,0" FontSize="{DynamicResource FontSize}" Background="Transparent" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderThickness="0" Padding="4,0,4,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}" VerticalOffset="5">
                    <Border Background="{DynamicResource SubtlePopUpBackgroundBrush}"
                            BorderThickness="{DynamicResource PopupBorderThickness}"
                            BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="{DynamicResource RadiusCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="{DynamicResource Inset2}" Name="PART_ElemSearchHost">
                                <!-- "Show only selected" - Playnite binds it by name, so dropping it
                                     silently removed the control that lets you review your current
                                     selection. That is exactly what you need once a filter has more
                                     than a screenful of options. Docked before the SearchBox so the
                                     box (the DockPanel's fill child) yields the space, matching
                                     Playnite's own ordering. Belongs to this template only - the
                                     base ComboBoxListBaseTemplate has no search host in either
                                     theme, which is correct. -->
                                <CheckBox DockPanel.Dock="Right"
                                          x:Name="PART_ToggleSelectedOnly"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{DynamicResource LOCOnlyItemsSelectedTooltip}"
                                          FontFamily="{DynamicResource IconFontFamily}" />
                                <SearchBox DockPanel.Dock="Left" x:Name="PART_SearchBox" />
                            </DockPanel>
                            <ItemsControl x:Name="PART_ItemsPanel" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=MainToggle}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}" TargetName="Root"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ComboBoxListItemStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
        <Setter Property="Padding" Value="8,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource RadiusCard}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BulletScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Grid Width="20" Height="20">
                                    <Viewbox x:Name="CheckIcon" Visibility="Collapsed" Margin="5"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Viewbox.RenderTransform>
                                            <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
                                        </Viewbox.RenderTransform>
                                        <TextBlock Text="&#xECCC;" Foreground="{DynamicResource TextBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                FontFamily="{DynamicResource IconFontFamily}"/>
                                    </Viewbox>
                                    <Viewbox x:Name="IndeterminateIcon" Visibility="Collapsed" Margin="5">
                                        <TextBlock Text="&#xECCC;" Foreground="{DynamicResource TextBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                FontFamily="{DynamicResource IconFontFamily}"/>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True"
                                            Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}"/>
                                <Condition Property="IsThreeState" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BulletScale" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.85"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.15"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.95"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BulletScale" Storyboard.TargetProperty="ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.85"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.15"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.95"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.05">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.2">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <StaticResource ResourceKey="EaseEmphasized"/>
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.05">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.2">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <StaticResource ResourceKey="EaseEmphasized"/>
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseStandard}"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseStandard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon"/>
                            <Setter Property="Background" Value="{DynamicResource AccentIdleBrush}" TargetName="BulletBorder"/>
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="BulletBorder"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderHoverBrush}" TargetName="BulletBorder"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource AccentIdleBrushDarker}" TargetName="BulletBorder"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type ComboBoxList}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource GlassControlBrushDark}"/>
        <Setter Property="Template" Value="{DynamicResource ComboBoxListBaseTemplate}" />
    </Style>
    
    <Style TargetType="{x:Type DdItemListSelectionBox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource GlassControlBrushDark}"/>
        <Setter Property="Template" Value="{DynamicResource FilterComboBoxListTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GlassControlBrushDark}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>