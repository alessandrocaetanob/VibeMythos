<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ⚠️ Motion tokens are duplicated here on purpose. Do not "clean this up" by pointing
         them at Constants.xaml - that is exactly what broke the theme on 2026-08-20.

         ThemeManager.ApplyTheme pre-flights EVERY theme file through Xaml.FromFile before it
         merges ANY of them, so during that pass StaticResource resolves against Playnite's
         default theme only - Constants.xaml is parsed but not yet in scope. A storyboard
         inside a Style or ControlTemplate must be frozen for the timing system, and freezing
         forces its StaticResource to resolve THEN, eagerly, instead of being deferred the way
         an ordinary Setter value is. So a motion token in Constants.xaml is unreachable from
         here: DynamicResource cannot freeze, and StaticResource resolves too early.

         Same values as Constants.xaml, which stays the source of truth for what they mean.
         Change one, change them all - tools/check_xaml_wpf.ps1 -PreFlight catches the failure
         mode, but not a value that has drifted. -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.22</Duration>
    <Duration x:Key="MotionSlow">0:0:0.4</Duration>
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut"/>
    <BackEase x:Key="EaseEmphasized" EasingMode="EaseOut" Amplitude="0.3"/>


    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Width" Value="45" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <ControlTemplate.Resources>
                        <ElasticEase x:Key="ElasticEase" EasingMode="EaseOut" Oscillations="1"/>
                        <BounceEase x:Key="BounceEase" EasingMode="EaseOut" Bounces="1"/>
                        <Storyboard x:Key="ToRect">
                            <DoubleAnimation Storyboard.TargetName="Rect" Storyboard.TargetProperty="RadiusX"
                                                         To="12" Duration="{StaticResource MotionSlow}" EasingFunction="{StaticResource ElasticEase}"/>
                            <DoubleAnimation Storyboard.TargetName="Rect" Storyboard.TargetProperty="RadiusY"
                                                         To="12" Duration="{StaticResource MotionSlow}" EasingFunction="{StaticResource ElasticEase}"/>
                        </Storyboard>
                        <Storyboard x:Key="ToCircle">
                            <DoubleAnimation Storyboard.TargetName="Rect" Storyboard.TargetProperty="RadiusX"
                                                         To="10" Duration="{StaticResource MotionSlow}" EasingFunction="{StaticResource ElasticEase}"/>
                            <DoubleAnimation Storyboard.TargetName="Rect" Storyboard.TargetProperty="RadiusY"
                                                         To="10" Duration="{StaticResource MotionSlow}" EasingFunction="{StaticResource ElasticEase}"/>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Rectangle x:Name="Rect" RadiusX="10" RadiusY="10" Fill="{TemplateBinding Background}" Opacity="1"/>
                        <ProgressBar x:Name="PART_ProgressStatus"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Border 
                                Padding="10"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Viewbox RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                </Viewbox.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource ToRect}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource ToCircle}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.10" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseEmphasized}"/>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.10" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseEmphasized}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseEmphasized}"/>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseEmphasized}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlContrastBorderBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentIdleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>