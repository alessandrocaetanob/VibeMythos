<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

			<FadeImage x:Name="PART_ImageBackground"
           			Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
           			HorizontalAlignment="Center" VerticalAlignment="Top"
           			Margin="-85,0,0,0"
           			RenderTransformOrigin="0.5,0.5">
    			<FadeImage.RenderTransform>
        			<ScaleTransform ScaleX="1.03" ScaleY="1.03" />
    			</FadeImage.RenderTransform>

                        <!-- Ambient backdrop reach.
                             Deliberately no blur and no on/off toggle here: Playnite already
                             owns those. Its own settings drive blur amount, darkening amount and
                             ShowBackgroundImageOnWindow, and its FadeImage applies them
                             internally — the stock theme declares this element bare and still
                             gets a blurred background. Adding a BlurEffect on top only stacks a
                             second blur over an already-blurred image for no visible gain.

                             What Playnite has no equivalent for is how far the artwork reaches
                             before it fades out, which is purely a theme decision and was
                             hardcoded at 0.55. Raising it carries the artwork further down the
                             window; lowering it keeps it as a thin band behind the top panel. -->
			<FadeImage.ImageOpacityMask>
    				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        				<GradientStop Color="Black" Offset="0.0" />
        				<GradientStop Color="Transparent" Offset="{DynamicResource AmbientBackdropExtent}" />
        				<GradientStop Color="Transparent" Offset="1.0" />
    				</LinearGradientBrush>
			</FadeImage.ImageOpacityMask>
                        </FadeImage>

                    <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="-85,0,0,0" Opacity="1"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               IsHitTestVisible="False">
                        <!-- Left scrim, which keeps the sidebar and game list legible over the
                             artwork. Its reach was hardcoded at 0.5, which is half the window;
                             on an ultrawide that is a lot of screen to darken. -->
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CC000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="{DynamicResource AmbientBackdropScrimExtent}" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>


                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="Left"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}"/>

                            <ExplorerPanel DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}"
                                           Visibility="{Settings ExplorerPanelVisible}"/>
                            
                            <Grid DockPanel.Dock="Left">                                
                                <LibraryDetailsView x:Name="PART_ViewDetails"/>
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>

                        <TopPanel VerticalAlignment="Top" Grid.Row="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>