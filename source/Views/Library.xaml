<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

			<FadeImage x:Name="PART_ImageBackground"
           			Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
           			HorizontalAlignment="Center" VerticalAlignment="Top"
           			Margin="-85,0,0,0"
           			RenderTransformOrigin="0.5,0.5"
           			Tag="{DynamicResource EnableAmbientBackdrop}">
                        <!-- Ambient backdrop. Blur is applied to Playnite's existing background
                             layer rather than to a second image stacked behind it, which would
                             double the artwork and the cost.

                             RenderTransform is set through the style, not inline, because a local
                             value would beat the trigger's setter. The scale rises with the blur:
                             BlurEffect samples past the element's bounds as transparent, so an
                             unscaled image shows a soft washed-out rim. The overscan pushes that
                             falloff outside the visible area.

                             RenderingBias=Performance because this covers the whole window and
                             re-renders on every selection change; on a backdrop this dim the
                             quality difference is not perceptible. -->
                        <FadeImage.Style>
                            <Style TargetType="FadeImage">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="{DynamicResource AmbientBackdropBlur}"
                                                            KernelType="Gaussian"
                                                            RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </FadeImage.Style>

			<FadeImage.ImageOpacityMask>
    				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        				<GradientStop Color="Black" Offset="0.0" />
        				<GradientStop Color="Transparent" Offset="0.55" />
        				<GradientStop Color="Transparent" Offset="1.0" />
    				</LinearGradientBrush>
			</FadeImage.ImageOpacityMask>
                        </FadeImage>

                    <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="-85,0,0,0" Opacity="1"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CC000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>


                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="Left"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}"/>

                            <ExplorerPanel DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}"
                                           Visibility="{Settings ExplorerPanelVisible}"/>
                            
                            <Grid DockPanel.Dock="Left">                                
                                <LibraryDetailsView x:Name="PART_ViewDetails"/>
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>

                        <TopPanel VerticalAlignment="Top" Grid.Row="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>