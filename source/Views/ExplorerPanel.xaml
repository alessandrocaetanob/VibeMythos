<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border Background="Transparent"
                            d:DesignWidth="200"
                            d:DesignHeight="400">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowSidebar}" Value="True">
                                        <Setter Property="Margin" Value="0,0,16,0" />
                                    </DataTrigger>                                   
                                    <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                                        <Setter Property="Margin" Value="16,0,16,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <!-- Playnite wires the panel's close affordance by this name. Without it
                                 the Explorer panel could only be dismissed from the View menu, which
                                 is a functional loss rather than a styling one - hard rule 6.
                                 Uses the theme's own GridCloseButton and Fluent close glyph rather
                                 than Playnite's Marlett "r", matching the Grid details panel. -->
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                                <Button Name="PART_ButtonClose"
                                        Content="&#xE8BB;"
                                        Style="{DynamicResource GridCloseButton}"
                                        DockPanel.Dock="Right"
                                        Width="35" Height="35"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        Cursor="Hand"
                                        ToolTip="{DynamicResource LOCMythos_Close}"/>
                                <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ExplorerComboBox}"/>
                            </DockPanel>
                            <Separator Height="1" DockPanel.Dock="Top"
                                       BorderBrush="#1AFFFFFF"
                                       Focusable="False" SnapsToDevicePixels="True"/>
                            <ListBox Name="PART_SelectItems"
                                 DockPanel.Dock="Top" ItemContainerStyle="{StaticResource MenuListBoxItem}"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            </ListBox>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>