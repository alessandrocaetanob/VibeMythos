<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type MainWindow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MainWindow}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            d:DesignWidth="1280" d:DesignHeight="960">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>      
                                <Storyboard x:Key="VisibilityOn">
                                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin"
                                                                    Storyboard.TargetName="PART_Notifications">
                                        <SplineThicknessKeyFrame KeyTime="0:0:0" Value="0,-400,0,0" />
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.4" Value="0,20,0,0">
                                            <SplineThicknessKeyFrame.KeySpline>
                                                <KeySpline ControlPoint1="0.0, 0.0" ControlPoint2="0.6, 1.0" />
                                            </SplineThicknessKeyFrame.KeySpline>
                                        </SplineThicknessKeyFrame>
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.6" Value="0,10,0,0">
                                            <SplineThicknessKeyFrame.KeySpline>
                                                <KeySpline ControlPoint1="0.4, 0.0" ControlPoint2="1.0, 1.0" />
                                            </SplineThicknessKeyFrame.KeySpline>
                                        </SplineThicknessKeyFrame>
                                    </ThicknessAnimationUsingKeyFrames>
                                </Storyboard>

                                <Storyboard x:Key="VisibilityOff">
                                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin"
                                                                    Storyboard.TargetName="PART_Notifications">
                                        <SplineThicknessKeyFrame KeyTime="0:0:0" Value="0,10,0,0" />
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.25" Value="0,20,0,0">
                                            <SplineThicknessKeyFrame.KeySpline>
                                                <KeySpline ControlPoint1="0.4, 0.0" ControlPoint2="1.0, 1.0" />
                                            </SplineThicknessKeyFrame.KeySpline>
                                        </SplineThicknessKeyFrame>
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.5" Value="0,-400,0,0">
                                            <SplineThicknessKeyFrame.KeySpline>
                                                <KeySpline ControlPoint1="0.0, 0.0" ControlPoint2="0.6, 1.0" />
                                            </SplineThicknessKeyFrame.KeySpline>
                                        </SplineThicknessKeyFrame>
                                    </ThicknessAnimationUsingKeyFrames>
                                </Storyboard>
                           </Grid.Resources>
                            <Grid>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="85,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=PART_ContentView, Path=DataContext.ActiveView.Tag, TargetNullValue='', FallbackValue=''}" Value="Library">
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <ContentControl Name="PART_ContentView" />
                                </Border>
                                <DockPanel>
                                    <Sidebar x:Name="PART_Sidebar" Panel.ZIndex="999"
                                         DockPanel.Dock="Left" />

                                </DockPanel>
                            </Grid>
                            
                            <NotificationPanel x:Name="PART_Notifications"
                                               WindowChrome.IsHitTestVisibleInChrome="True"
                                               Width="320" MinHeight="200" MaxHeight="500"
                                               Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               AnimatedVisibility.Visibility="{Settings NotificationPanelVisible}"
                                               AnimatedVisibility.Visible="{StaticResource VisibilityOn}"
                                               AnimatedVisibility.Collapsed="{StaticResource VisibilityOff}"/>

                            <!-- Now Playing toast (UniPlaySong).
                                 Driven by IsMusicChanged, which pulses True on every track
                                 change and returns to False a moment later. No PluginStatus
                                 gate is needed: {PluginSettings} no-ops when the plugin is
                                 absent, so the pulse never fires and the toast stays at
                                 Opacity 0. Margin clears the 60px top panel and its margins;
                                 the notification panel is centre-aligned, so there is no
                                 collision. IsHitTestVisible=False keeps it display-only. -->
                            <Border x:Name="NowPlayingToast"
                                    Grid.Row="0" Grid.Column="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,90,24,0"
                                    Panel.ZIndex="1000"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    MinWidth="260" MaxWidth="380"
                                    Padding="14,12"
                                    Background="{DynamicResource GlassControlBrushDark}"
                                    BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                                    BorderThickness="1"
                                    Tag="{DynamicResource ShowNowPlayingToast}">

                                <!-- Animated by property path, never by TargetName: a Storyboard
                                     inside a Style may not use Storyboard.TargetName, and doing
                                     so throws and crashes Playnite. Hence no x:Name here. -->
                                <Border.RenderTransform>
                                    <TranslateTransform X="40"/>
                                </Border.RenderTransform>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadiusLarge}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=IsMusicChanged, FallbackValue=False}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                             To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0" BeginTime="0:0:4.5" Duration="0:0:0.5"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                             To="40" BeginTime="0:0:4.5" Duration="0:0:0.5"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="56" Height="56" Margin="0,0,12,0"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            ClipToBounds="True">
                                        <Image Source="{PluginSettings Plugin=UniPlaySong, Path=NowPlayingAlbumArtPath}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCMythos_NowPlaying}"
                                                   FontFamily="{DynamicResource FontFamily}"
                                                   FontSize="{DynamicResource FontSizeSmaller}"
                                                   FontWeight="{DynamicResource FontWeightDisplay}"
                                                   Opacity="0.7"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource AccentIdleBrush}"/>
                                        <TextBlock Text="{PluginSettings Plugin=UniPlaySong, Path=NowPlayingTitle}"
                                                   FontFamily="{DynamicResource TightFont}"
                                                   FontSize="{DynamicResource FontSizeLarge}"
                                                   FontWeight="{DynamicResource FontWeightDisplay}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="280"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{PluginSettings Plugin=UniPlaySong, Path=NowPlayingArtist}"
                                                   FontFamily="{DynamicResource FontFamily}"
                                                   FontSize="{DynamicResource FontSize}"
                                                   Opacity="0.8"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="280"
                                                   HorizontalAlignment="Left"/>
                                        <!-- Live position/duration from the unified active-media surface
                                             (flat paths, UniPlaySong 1.5.8+). ActiveMediaProgress is 0-100,
                                             matching ProgressBar's default Maximum. Of the two Visibility
                                             triggers, the later wins when both match. -->
                                        <Grid Margin="0,6,0,0" MinWidth="180" MaxWidth="280">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=ActiveMediaHasMedia, FallbackValue=False}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=UniPlaySong, Path=ActiveMediaDurationText, FallbackValue=''}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{PluginSettings Plugin=UniPlaySong, Path=ActiveMediaPositionText}"
                                                       FontFamily="{DynamicResource FontFamily}"
                                                       FontSize="{DynamicResource FontSizeSmaller}"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1"
                                                         Height="4"
                                                         Margin="8,0"
                                                         BorderThickness="0"
                                                         Background="{DynamicResource ContentBorderBrushOverlay}"
                                                         Value="{PluginSettings Plugin=UniPlaySong, Path=ActiveMediaProgress, FallbackValue=0, Mode=OneWay}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{PluginSettings Plugin=UniPlaySong, Path=ActiveMediaDurationText}"
                                                       FontFamily="{DynamicResource FontFamily}"
                                                       FontSize="{DynamicResource FontSizeSmaller}"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>