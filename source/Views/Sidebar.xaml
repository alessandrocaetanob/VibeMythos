<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">
    <!-- ⚠️ Motion tokens are duplicated here on purpose. Do not "clean this up" by pointing
         them at Constants.xaml - that is exactly what broke the theme on 2026-08-20.

         ThemeManager.ApplyTheme pre-flights EVERY theme file through Xaml.FromFile before it
         merges ANY of them, so during that pass StaticResource resolves against Playnite's
         default theme only - Constants.xaml is parsed but not yet in scope. A storyboard
         inside a Style or ControlTemplate must be frozen for the timing system, and freezing
         forces its StaticResource to resolve THEN, eagerly, instead of being deferred the way
         an ordinary Setter value is. So a motion token in Constants.xaml is unreachable from
         here: DynamicResource cannot freeze, and StaticResource resolves too early.

         Same values as Constants.xaml, which stays the source of truth for what they mean.
         Change one, change them all - tools/check_xaml_wpf.ps1 -PreFlight catches the failure
         mode, but not a value that has drifted. -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.22</Duration>
    <Duration x:Key="MotionSlow">0:0:0.4</Duration>
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut"/>
    <BackEase x:Key="EaseEmphasized" EasingMode="EaseOut" Amplitude="0.3"/>

    
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">

                    <!-- Floating wrapper -->
                    <Grid x:Name="FloatingWrapper"
                          Tag="{DynamicResource UseFloatingSidebar}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Margin" Value="8,8,8,9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Background + corner radius layer -->
                        <Border x:Name="FloatingBackground"
                                Tag="{DynamicResource UseFloatingSidebar}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource GlassControlBrushLight}"/>
                                            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Content -->
                        <Border x:Name="BorderContentHolder"
                                BorderBrush="{DynamicResource ContentBrushOverlay}"
                                Tag="{DynamicResource UseFloatingSidebar}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel x:Name="DockContentHolder"
                                    Tag="{DynamicResource UseFloatingSidebar}" Width="50">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Margin" Value="10,12,9,10"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="Margin" Value="5,6,5,5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="45" Height="45"
                                        DockPanel.Dock="Bottom" Padding="13" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="IconRotation" Angle="0"/>
                                        </Grid.RenderTransform>
                                        <Image x:Name="IconDefault"
                                               Source="{ThemeFile 'Images/settings.png'}"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                        <Image x:Name="IconHover"
                                               Source="{ThemeFile 'Images/settings_hover.png'}"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Opacity="0"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" SnapsToDevicePixels="True"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Border overlay -->
                        <Border x:Name="FloatingBorderOverlay"
                                IsHitTestVisible="False"
                                Tag="{DynamicResource UseFloatingSidebar}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ContentBrushOverlay}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="GlowAnimation">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource MotionBase}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="IconRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="GlowAnimation"/>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseStandard}"/>
                                        <DoubleAnimation Storyboard.TargetName="IconRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Left">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>