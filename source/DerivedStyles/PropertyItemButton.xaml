<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ⚠️ Motion tokens are duplicated here on purpose. Do not "clean this up" by pointing
         them at Constants.xaml - that is exactly what broke the theme on 2026-08-20.

         ThemeManager.ApplyTheme pre-flights EVERY theme file through Xaml.FromFile before it
         merges ANY of them, so during that pass StaticResource resolves against Playnite's
         default theme only - Constants.xaml is parsed but not yet in scope. A storyboard
         inside a Style or ControlTemplate must be frozen for the timing system, and freezing
         forces its StaticResource to resolve THEN, eagerly, instead of being deferred the way
         an ordinary Setter value is. So a motion token in Constants.xaml is unreachable from
         here: DynamicResource cannot freeze, and StaticResource resolves too early.

         Same values as Constants.xaml, which stays the source of truth for what they mean.
         Change one, change them all - tools/check_xaml_wpf.ps1 -PreFlight catches the failure
         mode, but not a value that has drifted. -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.22</Duration>
    <Duration x:Key="MotionSlow">0:0:0.4</Duration>
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut"/>
    <BackEase x:Key="EaseEmphasized" EasingMode="EaseOut" Amplitude="0.3"/>


    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock FontSize="{TemplateBinding FontSize}"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                           TextWrapping="Wrap"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IdleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyItemSmallButton" TargetType="Button">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource IdleBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock FontSize="{TemplateBinding FontSize}"
                           Foreground="{TemplateBinding Foreground}" 
                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                           TextWrapping="Wrap"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentIdleBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IdleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyItemLinkButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,4,8,6" />
        <Setter Property="Foreground" Value="{DynamicResource IdleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlIdleBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="10,6,10,6"
                            CornerRadius="{DynamicResource RadiusControl}"
                            BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IdleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyItemTagButton" TargetType="Button">
        <Setter Property="Tag" Value="{DynamicResource UseButtonBorders}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Margin" Value="0,2,8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlIdleBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Background layer -->
                        <Border x:Name="HoverBg"
                                CornerRadius="{DynamicResource RadiusControl}"
                                Background="{TemplateBinding Background}"/>
                        <!-- Overlay border layer -->
                        <Border x:Name="BorderOverlay"
                                CornerRadius="{DynamicResource RadiusControl}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Background="Transparent"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                        <!-- Content layer -->
                        <TextBlock Margin="10,6,10,6"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                TextWrapping="Wrap"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderOverlay"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterItemTagButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Margin" Value="0,2,6,4"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentIdleBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Background layer with opacity control -->
                        <Border x:Name="BgLayer"
                                Padding="8,5,8,5"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Opacity="0.2"/>
                        <!-- Text layer -->
                        <TextBlock x:Name="ButtonText"
                                Padding="8,5,8,5"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BgLayer"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="1" Duration="{StaticResource MotionFast}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BgLayer"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.2" Duration="{StaticResource MotionFast}">
                                            <DoubleAnimation.EasingFunction>
                                                <StaticResource ResourceKey="EaseStandard"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="White" TargetName="ButtonText"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource IdleBrush}" TargetName="ButtonText"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>