 <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}" CornerRadius="{DynamicResource RadiusCard}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">

                                <Grid x:Name="ImageMask" Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                    <Grid.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border Background="Black"
                                                        Width="{Binding ElementName=ImageMask, Path=ActualWidth}"
                                                        Height="{Binding ElementName=ImageMask, Path=ActualHeight}"
                                                        CornerRadius="{DynamicResource GridCornerRadius}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Grid.OpacityMask>
                                    <Image Name="PART_ImageCover"
                                        	HorizontalAlignment="Center" VerticalAlignment="Center"
                                        	RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                        	Stretch="{Settings CoverArtStretch}"/>
                                    <ContentControl x:Name="ThemeExtras_Banner"
						RenderOptions.BitmapScalingMode="Fant"
						Width="{Binding Width, ElementName=PART_ImageCover}"
						HorizontalAlignment="Center"
						VerticalAlignment="{DynamicResource GridViewCoverLibraryBannerAlign}"
						Tag="{DynamicResource GridViewCoverDisplayLibraryBanner}"
						Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border Tag="{DynamicResource GridViewCoverPlatformIcon}"
						Background="{DynamicResource GridOverlayGradient}"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Margin="0"
						IsHitTestVisible="False"
						Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <!--Game Not Installed-->
                                    <Border Background="Transparent" x:Name="TextGameName" Visibility="Collapsed"/>
                                    <Border Background="#B3000000" x:Name="BorderMouseOver" Visibility="Collapsed"/>
                                    <!--Game Not Installed-->
                                </Grid>

                                <Border Name="GameControls"
                                        Visibility="Collapsed"
                                        CornerRadius="{DynamicResource GridCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ButtonPlay}" Value="Visible">
                                                    <Setter Property="Background" Value="#80000000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Button Name="PART_ButtonInfo"
                                                Tag="{DynamicResource GridViewDetailsPanel}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Margin="0"
                                                VerticalAlignment="Stretch"
                                                Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Name="PART_ButtonPlay"
                                                Tag="{DynamicResource GridViewPlayButtons}"
                                                Content="&#xF5B0;"
                                                Style="{StaticResource GridViewPlayButton}"
                                                Focusable="False"
                                                Margin="0"
                                                Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <Border Tag="{DynamicResource GridViewShowFavorites}" Background="{DynamicResource FavBrush}" Width="30" Height="30" CornerRadius="8" Margin="16,8,8,16"
                                        VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Favorite}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE735;" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="{DynamicResource FontSizeLarge}" />
                                </Border>
                                <!-- DuplicateHider source selector: one clickable icon per copy of
                                     the game. Click selects a copy, double-click launches it.
                                     Needs no PluginStatus gate — when the plugin is absent or its
                                     UI Integration setting is off, Playnite leaves the
                                     ContentControl empty and the host collapses to nothing.
                                     Styling comes from DuplicateHider_Icon{ContentControl,
                                     StackPanel}Style in Common.xaml. -->
                                <Border x:Name="DhSelectorHost"
                                        Tag="{DynamicResource GridViewCoverSourceSelector}"
                                        Background="Transparent"
                                        Margin="10"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ContentControl x:Name="DuplicateHider_SourceSelector"
                                                    HorizontalAlignment="Left"
                                                    VerticalContentAlignment="Center" />
                                </Border>

                                <!-- Legacy single-source badge, kept for users without the plugin.
                                     Hidden whenever the selector above is enabled, since both
                                     occupy the same bottom-left corner. -->
                                <Border Tag="{DynamicResource GridViewCoverPlatformIcon}"
					Background="Transparent"
					Width="22"
					Height="22"
					Margin="10"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Tag, ElementName=DhSelectorHost}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{ThemeFileBinding Game.Source.Name, PathFormat='Icons/Platform Source/{0}.png'}"
                                        HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="Fant"/>
                                </Border>
                                <Border Tag="{DynamicResource GridViewCoverCloudIcon}"
                                        Background="Transparent"
                                        Width="30" Height="30"
                                        Margin="10,10,10,7"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding IsInstalled}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="{StaticResource CloudIconGeometry}"
                                        Fill="#BFFFFFFF"
                                        Width="22" Height="22"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <Grid>
                                    <Border BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource GridCornerRadius}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Margin="0"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                            
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="&#xF0AE;" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName"/>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>