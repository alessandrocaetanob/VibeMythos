<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="25" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" Padding="5,25,5,5" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0"/>
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,-20,0,0">
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                        <!-- Playnite binds the window title by this name. Without it every
                                             non-main window - Settings, Add Game, metadata dialogs and every
                                             plugin's config window - rendered three system buttons over a
                                             blank caption strip. MainWindowStyle.xaml already declares this
                                             correctly; StandardWindowStyle simply omitted it. -->
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Opacity="0.75" Style="{DynamicResource BaseTextBlockStyle}"
                                                   x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="5" >
                                            <Button Style="{DynamicResource WinSysButton}"
                                                    Content="{StaticResource WinSysMinIconGeometry}"
                                                    x:Name="PART_ButtonMinimize"
                                                    Margin="0,0,5,0"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                                            <Button Style="{DynamicResource WinSysButton}"
                                                    Content="{StaticResource WinSysMaxIconGeometry}"
                                                    x:Name="PART_ButtonMaximize"
                                                    Margin="0,0,5,0"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                                            <Button Style="{DynamicResource WinSysCloseButton}"
                                                    Content="{StaticResource WinSysCloseIconGeometry}"
                                                    x:Name="PART_ButtonClose"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <!-- Also dropped when this template was forked, and restored here to match
                         MainWindowStyle.xaml, which carries both:

                         - Maximized adds border padding so the window does not bleed past the
                           work area. Note MainWindowStyle deliberately does NOT swap the maximise
                           glyph the way Playnite's default does: the default sets Content="2", a
                           character in its icon font, whereas this theme's WinSys buttons take a
                           Geometry and no restore geometry exists. Matching that omission rather
                           than inventing a glyph keeps the two window styles consistent.

                         - HasChildWindow dims the parent to 0.4 while a modal child is open.
                           That is a real affordance, not decoration - without it a dialog opened
                           on top of a settings window gives no visual cue about which one is
                           live, and both render on the same near-black surface. -->
                    <ControlTemplate.Triggers>
                        <!-- 13,33,13,13 rather than the uniform 8 MainWindowStyle uses, because the
                             two templates start from different baselines. MainWindowStyle's border
                             has NO padding, so 8 is a pure addition. This border starts at
                             5,25,5,5, where the 25 top is what reserves the caption strip - and a
                             Setter REPLACES the value rather than adding to it.

                             Setting a uniform 8 here collapsed that reserve, and since the caption
                             DockPanel below carries Margin="0,-20,0,0" it landed at 8-20 = -12px:
                             the window title and the min/max/close buttons rendered off the top
                             edge of every maximised dialog. Same +8 delta, applied to the real
                             baseline. -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Padding" Value="13,33,13,13" TargetName="WindowBorder"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder"/>
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>