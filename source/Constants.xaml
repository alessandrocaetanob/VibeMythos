    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#323236" />
    <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="#323236" />


    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />

