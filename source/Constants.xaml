         aliases SubtalBrush / SubtalBrushLighter (HYP-197) were retired in HYP-251 once the
         last of their 16 callers had migrated here. -->
    <Color x:Key="TextSubtleColor">#888991</Color>
    <Color x:Key="TextSubtleLighterColor">#9d9ea5</Color>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{DynamicResource TextSubtleColor}" />
    <SolidColorBrush x:Key="TextSubtleLighterBrush" Color="{DynamicResource TextSubtleLighterColor}" />
    <!-- Near-white foreground family (HYP-197). IdleBrush / HoverBrush / SelectedBrush are the
         same #E7E9EA, used as a bright FOREGROUND on dark surfaces - the names are historical,
         not roles. HoverBrush in particular is a foreground colour and must never paint a
         Background or Fill; the three sites that did (Menu header hover, the RoundedThumb
         slider handle) were the inconsistent-hover source and were retired in HYP-197.

         Hover BACKGROUNDS use one of two sanctioned ramps instead, chosen by surface material:
           - dark chrome  -> ContentBrushOverlay (#1AFFFFFF) rest, ContentBrushOverlayHover
                             (#33FFFFFF) hover: a translucent white overlay that lifts the surface.
           - input fields -> GlassControlBrushDark (#40000000): a dark glass fill; these give
                             focus feedback (an AccentHighlightBrush border), not a hover colour. -->
    <SolidColorBrush x:Key="IdleBrush" Color="#E7E9EA" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E7E9EA" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E7E9EA" />

    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#024DA3" />
    <!-- Favourite affordance (grid badge, favourite toggle, add/remove-favourite icons).
         Retired from literal Yellow (HYP-251): pure Yellow read as harsh on the dark surfaces.
         A warm favourite gold, distinct from PlatinumColor's achievement-completion gold. -->
    <SolidColorBrush x:Key="FavBrush" Color="#F2C24E" />

