    <Color x:Key="TrueWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="WhiteBrush" Color="#18181B" />
    <SolidColorBrush x:Key="TrueWhiteBrush" Color="{DynamicResource TrueWhiteColor}" />
