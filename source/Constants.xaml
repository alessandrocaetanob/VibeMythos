    <CornerRadius x:Key="GridCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="GridCornerRadiusBorder">17</CornerRadius>
    
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- DELIBERATELY INVERTED - do not "fix" these, and do not delete them as unused.
         Both are Playnite-global keys: the theme itself never references them, but Playnite
         core resolves them for its own chrome and dialogs. Redefining WhiteColor as a near-black
         (#18181B) and BlackColor as a mid grey (#707275) is what forces Playnite's own
         light-themed lookups to render dark. A reference search will report them as dead; they
         are not. See the Playnite-global check in CLAUDE.md under Validating changes. -->
    <Color x:Key="BlackColor">#707275</Color>
    <Color x:Key="WhiteColor">#18181B</Color>
    <Color x:Key="GreenColor">#34c759</Color>
    <Color x:Key="TextColor">#E4E4E6</Color>
    <Color x:Key="TextColorDarker">#888991</Color>
    <Color x:Key="TextColorDark">#FF000000</Color>
