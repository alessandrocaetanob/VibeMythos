    <Color x:Key="PopupBackgroundColor">#000000</Color>
    <Color x:Key="PopupBorderColor">#28282b</Color>

    <SolidColorBrush x:Key="SubtlePopUpBackgroundBrush" Color="#0c0c0e" />
    <SolidColorBrush x:Key="SubtlePopUpControlBrush" Color="#1d1d1f" />
    <SolidColorBrush x:Key="SubtleControlBackgroundBrush" Color="#121214" />

    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    
    <Color x:Key="BackgroundToneColor">#FFCC00</Color>
    <Color x:Key="GridItemBackgroundColor">Transparent</Color>

    <Color x:Key="PanelSeparatorColor">#242427</Color>

    <Color x:Key="WindowPanelSeparatorColor">#1418181B</Color>
    <Color x:Key="DataChangeNotifColor">#FFA500</Color>


    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="GlobalBackgroundBrush" Color="Transparent" />

    <SolidColorBrush x:Key="GlassControlBrushDark" Color="#40000000" />
    <SolidColorBrush x:Key="GlassControlBrushLight" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="GlassBackgroundBrushDark" Color="#33000000" />

    <SolidColorBrush x:Key="ControlIdleBackgroundBrush" Color="#18181B" />
    <!-- Disabled must RECEDE, so it sits below idle on the elevation ramp:
         #141416 disabled < #18181B idle < #242427 hover < #323236 selected.
         Do not reach for DisabledBrush here - that is a disabled *foreground* token
         (#323236) used on Foreground everywhere else, and as a background it would make
         disabled the brightest state of the four and byte-identical to selected. -->
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#141416" />
    <SolidColorBrush x:Key="ControlIdleBorderBrush" Color="#323236" />
    <SolidColorBrush x:Key="ControlIdleBorderBrushOverlay" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ControlIdleBackgroundBrushOverlay" Color="#E618181B" />
    <SolidColorBrush x:Key="ContentBorderBrushOverlay" Color="#1AFFFFFF" />
    <!-- Below-rest tint steps, Nightglass (HYP-249). Extend the ContentBrushOverlay white-alpha
         ramp (10/15/20% below) downward to 5% and 8%, so a card can rise from below-rest up to
         the 20% cap. Material 3 dark-elevation math: depth by tint, not shadow. No consumers
         wired in this issue. -->
    <SolidColorBrush x:Key="ElevationTint0" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ElevationTint1" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ContentBrushOverlay" Color="#1AFFFFFF" />
