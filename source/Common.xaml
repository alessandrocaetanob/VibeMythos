<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style x:Key="BaseStyle" TargetType="Control">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource OpacitySecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource SelectedBrush}" />
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource OpacitySecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconFontStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource OpacitySecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- DuplicateHider source-selector styling.
         DuplicateHider looks these two keys up by name and applies them to the icon stack it
         injects into any ContentControl named DuplicateHider_SourceSelector. Each icon's
         DataContext is a ListData: Icon, IsCurrent, SourceName, Game, and the Launch/Select/
         Install commands. Deliberately no BasedOn — the plugin's own example bases on an
         implicit ContentControl style, which this theme does not define.

         No opacity animations here: the plugin recycles these elements when the selector's
         IsVisible flips, so an element animated to Opacity 0 while still Visible can be
         reused in that state. Static trigger states only. -->
    <Style x:Key="DuplicateHider_IconContentControlStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding SourceName}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Chip"
                            Background="{DynamicResource GlassControlBrushDark}"
                            BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource Inset1}">
                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- An uninstalled copy recedes rather than disappears. -->
                        <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                            <Setter TargetName="Chip" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                        <!-- The copy currently in view carries the accent. -->
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentIdleBrush}" />
                        </DataTrigger>
                        <!-- Last, so hover restores full opacity on uninstalled copies too. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ContentBrushOverlayTwo}" />
                            <Setter TargetName="Chip" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DuplicateHider_IconStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Selector 1, used in the Details View library row. The numbered styles are not
         cosmetic duplication: DuplicateHider only registers DuplicateHider_SourceSelectorN
         if a matching DuplicateHider_IconContentControlStyleN or IconStackPanelStyleN
         exists, so omitting these would leave that placement silently empty. A second
         index also keeps the two placements from sharing one element cache. -->
    <Style x:Key="DuplicateHider_IconContentControlStyle1" TargetType="ContentControl"
           BasedOn="{StaticResource DuplicateHider_IconContentControlStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style x:Key="DuplicateHider_IconStackPanelStyle1" TargetType="StackPanel"
           BasedOn="{StaticResource DuplicateHider_IconStackPanelStyle}" />

    <!-- Selector 2, the same library row in the Grid View details panel. -->
    <Style x:Key="DuplicateHider_IconContentControlStyle2" TargetType="ContentControl"
           BasedOn="{StaticResource DuplicateHider_IconContentControlStyle1}" />

    <Style x:Key="DuplicateHider_IconStackPanelStyle2" TargetType="StackPanel"
           BasedOn="{StaticResource DuplicateHider_IconStackPanelStyle}" />

    <Style x:Key="DetailViewCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="2" Color="Black" Opacity="0.2" ShadowDepth="1" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Metadata row chrome (HYP-196) ====================

         The metadata block exists twice - once in DetailsViewGameOverview, once in the Grid
         View drawer - and its chrome was identical at all 34 sites: same padding, same
         divider, same label alignment. These two styles are that chrome, in one place.

         ⚠️ CHROME ONLY. The Border and Label elements themselves stay inline in both views,
         and every x:Name="PART_Elem*" stays with them. Playnite resolves PART_* by name
         within the *view's* namescope, and a shared DataTemplate or ControlTemplate creates
         a new one - the row would render and silently stop being populated, which is the
         same failure class as the dropped progress-bar parts in HYP-155. Styles do not
         create a namescope, which is exactly why this is the safe half to share.

         The 34 <Grid.ColumnDefinitions> blocks with SharedSizeGroup="Left" cannot join them:
         ColumnDefinitions is a read-only collection, so no Setter can supply it, and the
         only other route is a template. They stay inline.

         The two views are NOT symmetric, so nothing here assumes they are - it is per-element
         styling, applied wherever a row exists. Details carries three rows Grid does not
         (PART_ElemFeatures, PART_ElemGenres, PART_ElemNotes).

         Padding stays 0,11,0,11 rather than moving onto the 4px grid. That is a 2px change to
         the height of all 34 rows and wants eyes on a running Playnite; the point of this
         change is that it is now one edit rather than 34. -->
    <!-- BasedOn is load-bearing on both of these. Setting Style="..." on an element REPLACES
         the implicit style for its type, it does not add to it - and Playnite's default theme
         supplies both. Dropping them cost the metadata labels their Foreground AND their
         ControlTemplate (black text on a near-black panel, shipped 2026-08-20), and cost every
         divider its SnapsToDevicePixels. Neither failure produces an error. -->
    <Style x:Key="MetadataRowBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="Padding" Value="0,11,0,11" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentBorderBrushOverlay}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="MetadataRowLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>