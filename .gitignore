# SonarQube CLI scratch directories
.sonar/

# Serena project config — auto-generated per working copy, machine-specific
.serena/

# Python bytecode. tools/validate_theme.py is a script, but importing it (to unit-probe
# a regex, or from a CI step) writes tools/__pycache__ next to it.
__pycache__/
*.py[cod]

# Playnite resolves its database path against the *current working directory*, so
# launching Playnite.DesktopApp.exe from a shell sitting in the repo builds a fresh
# ~50MB library/ here instead of using F:\Playnite\library (hit in HYP-212).
library/
