<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1880"
                                  d:DesignHeight="1550"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid Margin="0,0,0,20">
                            <Separator Background="{x:Null}" VerticalAlignment="Top" Margin="15,0,25,0" />
                            <!-- Background Image -->
                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ImageBackground, Path=Visibility}" Value="Collapsed" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Border Background="Black" IsHitTestVisible="False"
                                        Height="{Binding ElementName=PART_ImageBackground, Path=Height}"
                                        Opacity="1" />
                                <Grid.OpacityMask>
                                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="2" RadiusY="0.9">
                                        <RadialGradientBrush.GradientStops>
                                            <GradientStop Color="Black" Offset="0.3" />
                                            <GradientStop Color="Transparent" Offset="0.85" />
                                        </RadialGradientBrush.GradientStops>
                                    </RadialGradientBrush>
                                </Grid.OpacityMask>
                            </Grid>

                                    <!--Right Side-->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0">
                                        
                                        <!--Extra Logo-->
                                        <Grid Height="200" Margin="10,20,10,20">
                                            <Border x:Name="GameIcon" CornerRadius="0">
                                                <Image Name="PART_ImageIcon" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="Fant" MaxHeight="120" MaxWidth="120"/>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border x:Name="ExtraMetadataLoader_LogoLoaderControlGrid" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                    Tag="{DynamicResource DetailsViewAllowUseOfLogos}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false" >
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"/>
                                            </Border>
                                        </Grid>
                                        <!--Extra Logo Ends-->
                                            
                                        <!--Aciton Buttons-->
                                        <StackPanel Margin="0,0,0,10">

					<ItemsControl ItemsSource="{Binding Game.AgeRatings}">
    						<ItemsControl.ItemsPanel>
        						<ItemsPanelTemplate>
            							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
        						</ItemsPanelTemplate>
    						</ItemsControl.ItemsPanel>
    					<ItemsControl.ItemTemplate>
        					<DataTemplate>
					<Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
    						<Border x:Name="Mask" Background="#000000" CornerRadius="{DynamicResource ControlCornerRadius}" />

    						<Image x:Name="AgeRatingIcon"
           							MaxHeight="1024"
           							MaxWidth="300"
           							Source="{ThemeFileBinding Name, PathFormat='Images/AgeRating/{0}.bmp'}"
           							StretchDirection="Both"
           							Stretch="Uniform"
           							RenderOptions.BitmapScalingMode="HighQuality"
           							SnapsToDevicePixels="True"
           							UseLayoutRounding="True"
           							Margin="0"/>

    						<Border BorderBrush="{DynamicResource ControlIdleBorderBrush}"
            							BorderThickness="1"
            							CornerRadius="{DynamicResource ControlCornerRadius}"
            							Background="Transparent"
            							Width="300" 
            							HorizontalAlignment="Center"
            							VerticalAlignment="Stretch"
            							Panel.ZIndex="1"/>
  
    							<Grid.OpacityMask>
        							<VisualBrush Visual="{Binding ElementName=Mask}"/>
    							</Grid.OpacityMask>
					</Grid>
        					</DataTemplate>
    					</ItemsControl.ItemTemplate>
					</ItemsControl>

                                                <Grid>
                                                    <Button Name="PART_ButtonPlayAction" Style="{DynamicResource DetailPlayButton}"  />

                                                    <Button Name="PART_ButtonContextAction" Style="{DynamicResource DetailInstallButton}" />

                                                </Grid>
						<Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="0,10,0,10">
                                            		<Grid.ColumnDefinitions>
                                                		<ColumnDefinition Width="*" />
                                                		<ColumnDefinition Width="*" />
                                            		</Grid.ColumnDefinitions>

                                                	<Button Grid.Column="0" Name="PART_ButtonMoreActions" Margin="0,0,5,0" Focusable="False"
                                                        	Content="Options"  Height="48" FontSize="{StaticResource FontSizeLarge}"
                                                        	Style="{StaticResource SecondaryButton}"/>

                                                	<Button Grid.Column="1" x:Name="PART_ButtonEditGame" Margin="5,0,0,0" Focusable="False"
                                                        	Content="Manage"  Height="48" FontSize="{StaticResource FontSizeLarge}"
                                                        	Style="{StaticResource SecondaryButton}"/>
                                        	</Grid>
                                            </StackPanel>
                                        <!--Aciton Buttons Ends-->

                                        <!--HowLongToBeat-->
                                        <StackPanel Margin="0,0,0,32" Visibility="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource LOCHowLongToBeat}" Style="{DynamicResource BaseTextBlockStyle}" FontWeight="Bold" FontSize="14"/>

                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" 
                                                        Style="{DynamicResource DetailViewCardBorder}" Margin="0,12,0,0">

                                                    <StackPanel Margin="0,0,0,0">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="Label" x:Key="HltbGridLabelStyle">
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmaller}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
                                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                            </Style>
                                                            <Style TargetType="Border" x:Key="HltbBorderStyle">
                                                                <Setter Property="Background" Value="{DynamicResource IdleBrush}"/>
                                                                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                                                            </Style>
                                                            <Style TargetType="TextBlock" x:Key="HltbGridTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                                                <Setter Property="Margin" Value="8,8,8,8" />
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="--">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Resources>

                                                        <Grid Margin="16,12,16,16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>



                                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                <Label Content="{DynamicResource LOCHowLongToBeatMainStory}"
                                                                       Style="{DynamicResource HltbGridLabelStyle}"
                                                                       Visibility="{Binding ElementName=MainStoryFormat, Path=Visibility}" />
                                                                <Border Style="{DynamicResource HltbBorderStyle}">
                                                                    <TextBlock Name="MainStoryFormat" Style="{DynamicResource HltbGridTextStyle}"
                                                                               Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='--'}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">

                                                                <Label Content="{DynamicResource LOCHowLongToBeatMainExtra}"
                                                                       Style="{DynamicResource HltbGridLabelStyle}"
                                                                       Visibility="{Binding ElementName=MainExtraFormat, Path=Visibility}" />
                                                                <Border Style="{DynamicResource HltbBorderStyle}">
                                                                    <TextBlock Name="MainExtraFormat"
                                                                               Style="{DynamicResource HltbGridTextStyle}"
                                                                               Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat, FallbackValue='--'}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Margin="0,0,0,0">

                                                                <Label Content="{DynamicResource LOCHowLongToBeatCompletionist}"
                                                                       Style="{DynamicResource HltbGridLabelStyle}"
                                                                       Visibility="{Binding ElementName=CompletionistFormat, Path=Visibility}" />
                                                                <Border Style="{DynamicResource HltbBorderStyle}">
                                                                    <TextBlock Name="CompletionistFormat"
                                                                               Style="{DynamicResource HltbGridTextStyle}"
                                                                               Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat, FallbackValue='--'}"/>
                                                                </Border>
                                                            </StackPanel>

                                                        </Grid>

                                                        <Border Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="0,0,16,16">
                                                            <!--<DockPanel Margin="16,16,16,16">
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Foreground="{DynamicResource IdleBrush}" DockPanel.Dock="Left"/>
                                                                <TextBlock Name="PART_TextPlayTime" DockPanel.Dock="Right" TextAlignment="Right" FontWeight="Bold"/>
                                                            </DockPanel>-->
                                                        </Border>

                                                    </StackPanel>

                                                </Border>
                                            </StackPanel>
                                        <!--HowLongToBeat Ends-->                                    

                                        <!--Details Panel-->
                                        <StackPanel Margin="0,0,0,26">
                                            <StackPanel.Resources>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FlowDirection" Value="RightToLeft"/>
                                                </Style>
                                                <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                    <Setter Property="Margin" Value="0,0,12,0" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                    <Setter Property="MaxWidth" Value="140"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" >
                                                            <Setter Property="Margin" Value="0,0,0,0" />
                                                    	<Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </Style>
                                            </StackPanel.Resources>
                                            <!--<TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,0,0,0"
                                                       Style="{DynamicResource BaseTextBlockStyle}" FontWeight="Bold" FontSize="14"/>-->

                                                    <!-- Install Size -->
                                                    <Border x:Name="PART_ElemInstallSize" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCInstallSizeLabel}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Name="PART_TextInstallSize" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Recent Activity -->
                                                    <Border x:Name="PART_ElemLastPlayed" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="Last Played" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Name="PART_TextLastActivity" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Series -->
                                                    <Border x:Name="PART_ElemSeries" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCSeriesLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsSeries" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Tags -->
                                                    <Border x:Name="PART_ElemTags" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCTagsLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsTags" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Developers -->
                                                    <Border x:Name="PART_ElemDevelopers" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCDeveloperLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsDevelopers" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Source -->
                                                    <Border x:Name="PART_ElemSource" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCSourceLabel}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="PART_ButtonSource" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Release Date -->
                                                    <Border x:Name="PART_ElemReleaseDate" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGameReleaseDateTitle}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="PART_ButtonReleaseDate" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Publishers -->
                                                    <Border x:Name="PART_ElemPublishers" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCPublisherLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsPublishers" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Region -->
                                                    <Border x:Name="PART_ElemRegion" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCRegionLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsRegions" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Added -->
                                                    <Border x:Name="PART_ElemAdded" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCDateAddedLabel}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Name="PART_TextAdded" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Categories -->
                                                    <Border x:Name="PART_ElemCategories" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGameCategoriesTitle}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsCategories" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Library -->
                                                    <Border x:Name="PART_ElemLibrary" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGameProviderTitle}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="PART_ButtonLibrary" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Platform -->
                                                    <Border x:Name="PART_ElemPlatform" Padding="0,11,0,11" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGamePlatformTitle}" VerticalAlignment="Center"/>
                                                            <Image Grid.Column="1" Source="{ThemeFileBinding Game.Platforms[0].SpecificationId, PathFormat='Icons/Labels/{0}.png'}" 
                                                                   HorizontalAlignment="Right" RenderOptions.BitmapScalingMode="HighQuality" Height="18" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>
                                        </StackPanel>
                                        <!--Details Panel Ends-->

                                        <!--Ratings-->
                                        <StackPanel Margin="0,0,0,32">

                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" 
                                                    Style="{DynamicResource DetailViewCardBorder}" Margin="0,0,0,0">

                                                <Grid Margin="16,12,16,12">
                                                    <Grid.Resources>
                                                        <Style TargetType="Label">
                                                            <Setter Property="FontSize" Value="{StaticResource FontSizeSmaller}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource IdleBrush}"/>
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge20}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource IdleBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <!--<Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}"/>-->
                                                        <Label Content="Community"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                                            <TextBlock Text="&#xe00a;" Style="{StaticResource IconFontStyle}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Game.CommunityScore, TargetNullValue='- -', FallbackValue='- -'}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <!--<TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" />-->
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <!--<Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />-->
                                                        <Label Content="Critics" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="&#xe00a;" Style="{StaticResource IconFontStyle}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Game.CriticScore, TargetNullValue='- -', FallbackValue='- -'}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <!--<TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" />-->
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <!--<Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" />-->
                                                        <Label Content="Personal" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="&#xe00a;" Style="{StaticResource IconFontStyle}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Game.UserScore, TargetNullValue='- -', FallbackValue='- -'}" 
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <!--<TextBlock Name="PART_TextUserScore" VerticalAlignment="Center" />-->
                                                        </StackPanel>
                                                    </StackPanel>

                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <!--Ratings Ends-->
                                        
                                        <!--Links-->
                                        <StackPanel Name="PART_ElemLinks" Margin="0,0,0,32">
                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource BaseTextBlockStyle}" 
                                                       FontWeight="Bold" FontSize="14" />
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" 
                                                    Style="{DynamicResource DetailViewCardBorder}" Margin="0,12,0,0">
                                                <ItemsControl ItemsSource="{Binding Game.Links}" Margin="10,12,10,8"
                                                              Visibility="{Binding ElementName=PART_ElemLinks, Path=Visibility}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type Link}">
                                                            <Button Content="{Binding Name}"
                                                                    Style="{StaticResource PropertyItemLinkButton}"
                                                                    ToolTip="{Binding Url}"
                                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.OpenLinkCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                        <!--Links End-->                    

                                    </StackPanel>
